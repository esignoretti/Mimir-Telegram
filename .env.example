# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Mimir API key (sk-mimir-...)
MIMIR_API_KEY=
# Comma-separated Telegram user ids allowed to use the bot
ALLOWED_TELEGRAM_USER_IDS=

# Optional
MIMIR_BASE_URL=https://mimir.cubbit.dev/v1
DEFAULT_MODEL=vllm/mimir-slim
DEFAULT_EFFORT=none
DB_PATH=/var/lib/mimir-telegram/mimir.db
SYSTEM_PROMPT=
NOTIFY_AFTER_SECONDS=60
HISTORY_TOKEN_BUDGET=200000
RETENTION_DAYS=90
HEALTHCHECK_URL=
LOG_LEVEL=INFO
